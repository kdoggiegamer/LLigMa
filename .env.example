# Copia questo file in `.env` e completa i valori.
# `.env` e' escluso dal versionamento: non mettere chiavi nel repository.
#
# PowerShell:  Copy-Item .env.example .env
# bash:        cp .env.example .env

# Endpoint OpenAI-compatibile del modello "docente".
# Serve alla distillazione (scripts/distill_tutor.py) e, se configurato,
# come backend di riserva nel servizio.
OPENAI_BASE_URL=https://freebuff.com/api/v1/paid

# Chiave del docente. Va incollata solo qui, mai in chat o nel codice.
OPENAI_API_KEY=

# Modello docente usato dalla distillazione. Deve esistere sull'endpoint:
# "python scripts/distill_tutor.py --list-models" elenca quelli disponibili.
TUTOR_TEACHER_MODEL=gpt-4o-mini
